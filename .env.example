DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS / reverse proxy (when DJANGO_DEBUG=0). Use https://your.domain for browser CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 = trust X-Forwarded-Proto from Nginx (recommended behind proxy)
DJANGO_USE_PROXY_SSL_HEADER=1
# Redirect HTTP to HTTPS (enable only when TLS terminates at Nginx)
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
# HSTS: set seconds >0 only when the site is always served over HTTPS (e.g. 31536000)
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Console log level: DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO

# DRF throttling (anon/user). Under pytest throttling is disabled automatically.
DRF_THROTTLE_ANON=100/hour
DRF_THROTTLE_USER=1000/hour

DB_NAME=cars_app
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Inbound integrations.
# Send telemetry mileage to POST /api/integrations/telematics/mileage/
# with header X-Integration-Token: <token>.
INTEGRATIONS_API_TOKEN=

# Outbound business-event webhook dispatcher.
INTEGRATIONS_OUTBOX_ENABLED=1
INTEGRATIONS_WEBHOOK_URL=
INTEGRATIONS_WEBHOOK_TIMEOUT_SECONDS=3
INTEGRATIONS_OUTBOX_MAX_ATTEMPTS=5
